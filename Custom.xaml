<local:MyCard xmlns:local="clr-namespace:PCL"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              Background="Transparent" Margin="0">
    <Border Background="#F8FAFC"
            CornerRadius="12"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            Padding="20,16"
            Margin="10,10,10,10">
        <StackPanel>

            <!-- 标题 -->
            <TextBlock Text="你好！{user} 让我们在这里开始"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#1E293B"
                       Margin="0,0,0,12" />

            <TextBlock Text="{}登录方式:{login}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#49628d"
                       Margin="0,0,0,12" />

            <!-- trademc.cc -->
            <Border Background="White"
                    CornerRadius="10"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    Margin="0,0,0,10"
                    Padding="12,10">
                <StackPanel>
                    <local:MyButton Height="42"
                                    HorizontalAlignment="Stretch"
                                    Padding="14,0"
                                    ColorType="Highlight"
                                    Text="TradeCraft NEXT"
                                    EventType="打开网页"
                                    EventData="https://mc.trademc.cc/"
                                    ToolTip="将使用你的默认浏览器打开" />
                    <TextBlock TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Foreground="#64748B"
                               FontSize="12"
                               Text="派系 宣战 夺地 在一张会改写的版图上写下你的国" />
                </StackPanel>
            </Border>

            <!-- LittleSkin 官网 -->
            <Border Background="White"
                    CornerRadius="10"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    Margin="0,0,0,10"
                    Padding="12,10">
                <StackPanel>
                    <local:MyButton Height="42"
                                    HorizontalAlignment="Stretch"
                                    Padding="14,0"
                                    ColorType="Highlight"
                                    Text="LittleSkin 官网"
                                    EventType="打开网页"
                                    EventData="https://littleskin.cn/user"
                                    ToolTip="将使用你的默认浏览器打开" />
                    <TextBlock TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Foreground="#64748B"
                               FontSize="12"
                               Text="LittleSkin 是Minecraft 皮肤站 在此管理你的皮肤与角色登录" />
                </StackPanel>
            </Border>

            <!-- 启动游戏 -->
            <local:MyButton Margin="0,0,10,0" 
                            Width="140" Height="40" 
                            HorizontalAlignment="Center" 
                            Padding="13,0,13,0" 
                            ColorType="Highlight" 
                            Text="服务器启动!!!" 
                            EventType="启动游戏" 
                            EventData="Tradecraft NEXT|trademc.cc" 
                            ToolTip="请确保已下载服务器整合包Tradecraft NEXT" />

            <TextBlock Text="—— 点击按钮即可跳转 ——"
                       Foreground="#94A3B8"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16" />
<local:MyCard Title="更新日志" Margin="0,0,0,15" CanSwap="True" IsSwaped="False">
    <StackPanel Margin="25,40,23,15">
        <TextBlock Text="最近更新内容" FontSize="14" Foreground="#888888" Margin="0,0,0,10"/>
        
        <local:MyListItem Title="26.09.25-01更新速递" 
                          Info="
1.定时修复在线玩家附近范围内生物AI
